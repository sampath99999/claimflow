# Copy to .env for docker-compose. Placeholders only; never commit real values.
POSTGRES_PASSWORD=change-me

# Service settings (defaults in each application.yml point at the local setup in the README)
DB_URL=jdbc:postgresql://localhost:54340/claimflow_claims
DB_USERNAME=postgres
DB_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:19340
MONGODB_HOST=localhost
MONGODB_PORT=27340
MEMBER_SERVICE_URL=http://localhost:8181
JWK_SET_URI=http://localhost:8180/.well-known/jwks.json
JWT_ISSUER=http://localhost:8180

# Gateway signing keys (PEM). Without them the gateway generates a key on every start.
CLAIMFLOW_JWT_PRIVATEKEY=file:/path/to/private.pem
CLAIMFLOW_JWT_PUBLICKEY=file:/path/to/public.pem
CORS_ALLOWED_ORIGINS=http://localhost:5191,http://localhost:5192
